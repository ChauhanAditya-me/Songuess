# Spotify Developer Credentials (Required for Vercel / Frontend)
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Audio Server URL (Optional: defaults to http://127.0.0.1:3001 if empty)
# Set to your Render URL (e.g. https://songuess-audio-server.onrender.com) for cloud audio streaming
VITE_AUDIO_SERVER_URL=

# Audio Server Port (Optional: defaults to 3001 locally or 10000 on Render)
PORT=3001
